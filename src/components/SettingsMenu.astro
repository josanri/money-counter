<header class="app-header" data-app-toolbar>
	<div class="app-header__inner">
		<span class="badge app-header__brand">
			<span class="badge__mark" aria-hidden="true"></span>
			<span data-i18n="pageTitle">Money Counter</span>
		</span>

		<details class="settings-menu">
			<summary class="settings-menu__trigger" aria-label="Settings">
				<span class="settings-menu__icon" aria-hidden="true"><span></span><span></span><span></span></span>
				<span class="visually-hidden" data-i18n="settings">Settings</span>
			</summary>
			<div class="settings-menu__panel">
				<div class="settings-menu__field">
					<span class="app-toolbar__label" id="language-label" data-i18n="langLabel">Language</span>
					<div class="settings-choice-group settings-choice-group--language" role="radiogroup" aria-labelledby="language-label">
						<button type="button" class="settings-choice is-selected" role="radio" aria-checked="true" tabindex="0" data-locale-choice="en">
							<span class="settings-choice__locale" aria-hidden="true">EN</span>
							<span data-i18n="languageEnglish">English</span>
							<span class="settings-choice__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="settings-choice" role="radio" aria-checked="false" tabindex="-1" data-locale-choice="es">
							<span class="settings-choice__locale" aria-hidden="true">ES</span>
							<span data-i18n="languageSpanish">Spanish</span>
							<span class="settings-choice__mark" aria-hidden="true"></span>
						</button>
					</div>
				</div>
				<button type="button" class="settings-customize" data-customize-open aria-haspopup="dialog" data-i18n="customize">Customize</button>
				<button type="button" class="settings-customize settings-customize--secondary" data-accounts-open aria-haspopup="dialog" data-i18n="savedAccountsMenu">Saved accounts</button>
				<div class="settings-install" data-settings-install-wrap hidden>
					<button
						type="button"
						class="settings-install__button"
						data-settings-install
						aria-controls="settings-install-help"
						aria-expanded="false"
					>
						<span class="settings-install__icon" aria-hidden="true">↓</span>
						<span data-i18n="installTitle">Install app</span>
					</button>
					<p class="settings-install__hint" id="settings-install-help" data-settings-install-help aria-live="polite" hidden></p>
				</div>
			</div>
		</details>
		<dialog class="customize-dialog" data-customize-dialog aria-labelledby="customize-title">
			<div class="customize-dialog__header">
				<div>
					<h2 id="customize-title" data-i18n="customizeTitle">Customize counter</h2>
					<p data-i18n="customizeDescription">Choose the controls and summary details that work for you.</p>
				</div>
				<button type="button" class="customize-dialog__close" data-customize-close aria-label="Close">×</button>
			</div>
			<div class="customize-dialog__options">
				<label class="settings-toggle">
					<span><strong data-i18n="largeControls">Large buttons</strong><small data-i18n="largeControlsHint">Make denomination controls easier to tap.</small></span>
					<input class="settings-toggle__input" type="checkbox" data-large-toggle />
					<span class="settings-toggle__track" aria-hidden="true"><span></span></span>
				</label>
				<label class="settings-toggle">
					<span><strong data-i18n="showBreakdown">Show coin and note subtotals</strong><small data-i18n="showBreakdownHint">Add a separate total for coins and bills.</small></span>
					<input class="settings-toggle__input" type="checkbox" data-breakdown-toggle />
					<span class="settings-toggle__track" aria-hidden="true"><span></span></span>
				</label>
				<div class="settings-menu__field">
					<span class="app-toolbar__label" id="palette-label" data-i18n="paletteLabel">Color theme</span>
					<div class="palette-options" role="radiogroup" aria-labelledby="palette-label" data-palette-options>
						<button type="button" class="palette-option is-selected" role="radio" aria-checked="true" tabindex="0" data-palette-choice="minimal">
							<span class="palette-option__preview" data-palette-preview="minimal" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
							<span class="palette-option__name" data-i18n="paletteMinimal">Minimal</span>
							<span class="palette-option__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="palette-option" role="radio" aria-checked="false" tabindex="-1" data-palette-choice="swiss">
							<span class="palette-option__preview" data-palette-preview="swiss" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
							<span class="palette-option__name" data-i18n="paletteSwiss">Swiss Minimalist</span>
							<span class="palette-option__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="palette-option" role="radio" aria-checked="false" tabindex="-1" data-palette-choice="neo">
							<span class="palette-option__preview" data-palette-preview="neo" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
							<span class="palette-option__name" data-i18n="paletteNeo">Neo Brutalism</span>
							<span class="palette-option__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="palette-option" role="radio" aria-checked="false" tabindex="-1" data-palette-choice="market">
							<span class="palette-option__preview" data-palette-preview="market" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
							<span class="palette-option__name" data-i18n="paletteMarket">Market</span>
							<span class="palette-option__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="palette-option" role="radio" aria-checked="false" tabindex="-1" data-palette-choice="coffee">
							<span class="palette-option__preview" data-palette-preview="coffee" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
							<span class="palette-option__name" data-i18n="paletteCoffeeShop">Coffee Shop</span>
							<span class="palette-option__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="palette-option" role="radio" aria-checked="false" tabindex="-1" data-palette-choice="fruitshop">
							<span class="palette-option__preview" data-palette-preview="fruitshop" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
							<span class="palette-option__name" data-i18n="paletteFruitshop">Fruit Shop</span>
							<span class="palette-option__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="palette-option" role="radio" aria-checked="false" tabindex="-1" data-palette-choice="butcher">
							<span class="palette-option__preview" data-palette-preview="butcher" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
							<span class="palette-option__name" data-i18n="paletteButcher">Butcher</span>
							<span class="palette-option__mark" aria-hidden="true"></span>
						</button>
					</div>
				</div>
				<div class="settings-menu__field">
					<span class="app-toolbar__label" id="appearance-label" data-i18n="themeLabel">Appearance</span>
					<div class="settings-choice-group settings-choice-group--appearance" role="radiogroup" aria-labelledby="appearance-label">
						<button type="button" class="settings-choice is-selected" role="radio" aria-checked="true" tabindex="0" data-theme-choice="system">
							<span class="settings-choice__preview" data-appearance-preview="system" aria-hidden="true"><span></span><span></span></span>
							<span data-i18n="themeAuto">Auto</span>
							<span class="settings-choice__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="settings-choice" role="radio" aria-checked="false" tabindex="-1" data-theme-choice="light">
							<span class="settings-choice__preview" data-appearance-preview="light" aria-hidden="true"><span></span><span></span></span>
							<span data-i18n="themeLight">Light</span>
							<span class="settings-choice__mark" aria-hidden="true"></span>
						</button>
						<button type="button" class="settings-choice" role="radio" aria-checked="false" tabindex="-1" data-theme-choice="dark">
							<span class="settings-choice__preview" data-appearance-preview="dark" aria-hidden="true"><span></span><span></span></span>
							<span data-i18n="themeDark">Dark</span>
							<span class="settings-choice__mark" aria-hidden="true"></span>
						</button>
					</div>
				</div>
			</div>
		</dialog>
		<dialog class="customize-dialog accounts-dialog" data-accounts-dialog aria-labelledby="accounts-title">
			<div class="customize-dialog__header">
				<div>
					<h2 id="accounts-title" data-i18n="savedAccountsTitle">Saved accounts</h2>
					<p data-i18n="savedAccountsDescription">Save this count and return to it later.</p>
				</div>
				<button type="button" class="customize-dialog__close" data-accounts-close aria-label="Close">×</button>
			</div>
			<form class="accounts-save" data-account-save-form>
				<label for="saved-account-name" data-i18n="accountNameLabel">Account name</label>
				<div class="accounts-save__fields">
					<input id="saved-account-name" name="accountName" maxlength="48" data-account-name data-i18n-placeholder="accountNamePlaceholder" placeholder="For example, Friday market" />
					<button type="submit" class="settings-customize" data-i18n="saveAccount">Save current</button>
				</div>
			</form>
			<p class="accounts-status" data-account-status aria-live="polite"></p>
			<p class="accounts-empty" data-accounts-empty data-i18n="noSavedAccounts">No saved accounts yet.</p>
			<ul class="accounts-list" data-accounts-list></ul>
		</dialog>
	</div>
</header>
