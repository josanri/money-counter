<aside class="install-bar" data-install-bar hidden>
	<hr class="rule install-bar__rule" />
	<div class="install-bar__inner">
		<div class="install-bar__copy">
			<p class="install-bar__title">
				<span class="badge badge--compact">
					<span class="badge__mark" aria-hidden="true"></span>
					<span data-i18n="installTitle">Install app</span>
				</span>
			</p>
			<p class="install-bar__body" data-install-body data-i18n="installBody">
				Add to your home screen for quick access.
			</p>
		</div>
		<div class="install-bar__actions">
			<button type="button" class="action-btn action-btn--solid install-bar__install" data-install hidden>
				<span data-i18n="installAction">Install</span>
				<span aria-hidden="true">→</span>
			</button>
			<button type="button" class="action-btn action-btn--ghost" data-install-dismiss data-i18n="installDismiss">
				Dismiss
			</button>
		</div>
	</div>
</aside>